
#!/bin/sh

# Block staged environment files, except example templates.
blocked_files=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '(^|/)\.env($|\.)' |
  grep -vE '(^|/)\.env\.example$')

if [ -n "$blocked_files" ]; then
    echo "ERROR: Environment files cannot be committed:"
    echo "$blocked_files"
    echo "Remove them from staging and use .env.example instead."
    exit 1
fi

echo "Environment file check passed."
